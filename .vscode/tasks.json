{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile SPARCS",
            "type": "shell",
            "command": "find src -name '*.java' | xargs javac -d out -cp 'lib/*:src:assets'",
            "windows": {
                "command": "Get-ChildItem -Recurse -Filter '*.java' src | ForEach-Object { $_.FullName } | ForEach-Object { javac -d out -cp 'lib/*;src;assets' $_ }"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false
            }
        },
        {
            "label": "Run SPARCS",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp",
                "out:lib/*:assets",
                "SPARCS"
            ],
            "windows": {
                "command": "java",
                "args": [
                    "-cp",
                    "out;lib/*;assets",
                    "SPARCS"
                ]
            },
            "dependsOn": ["Compile SPARCS"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true
            }
        }
    ]
}