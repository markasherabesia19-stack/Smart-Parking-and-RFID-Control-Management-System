{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile SPARCS",
            "type": "shell",
            "command": "Get-ChildItem -Recurse -Filter '*.java' -Path src | Select-Object -ExpandProperty FullName | ForEach-Object { javac -d out -cp 'lib/*;src/sparcs;assets' $_ }",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false
            }
        },
        {
            "label": "Copy db.properties",
            "type": "shell",
            "command": "if (Test-Path 'db.properties') { Copy-Item 'db.properties' 'out/db.properties' -Force; Write-Host '[OK] db.properties copied to out/' } else { Write-Warning 'db.properties not found in project root! Create it first.' }",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false
            }
        },
        {
            "label": "Run SPARCS",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp",
                "out;lib/*;assets",
                "SPARCS"
            ],
            "dependsOn": ["Compile SPARCS", "Copy db.properties"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true
            }
        }
    ]
}